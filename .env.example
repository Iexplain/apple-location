# ===== Server =====
NODE_ENV=production
PORT=3000
HTTP_HOST=127.0.0.1
HTTPS_HOST=0.0.0.0

# ===== VPN Server Configuration =====
# The public IP (or domain) of your VPN server (strongSwan).
# 203.0.113.10 is a non-routable documentation example. Replace both values.
VPN_SERVER_ADDRESS=203.0.113.10
VPN_REMOTE_ID=203.0.113.10

# Local service ports. WLOC stays bound to localhost and is reached through
# the VPN's 10.8.1.1:443 DNAT rule.
HTTPS_PORT=8444
WLOC_PORT=8445

# Optional browser CORS origin. Same-origin deployments can leave this empty.
CORS_ORIGIN=

# Required to access /api/vpn/server-bundle. Generate a unique random value;
# never commit the real token or expose the server private key anonymously.
SERVER_BUNDLE_TOKEN=replace-with-at-least-32-random-characters

# Required when NODE_ENV=production. Do not reuse these placeholder values.
ADMIN_USERNAME=replace-with-private-admin-username
ADMIN_PASSWORD=replace-with-at-least-16-random-characters

# ===== Certificate Info =====
CERT_ORGANIZATION=Virtual Location
CERT_ORGANIZATIONAL_UNIT=iOS Services
CERT_COUNTRY=CN
CERT_STATE=Beijing
CERT_LOCALITY=Beijing
# Validity in days (default 3650 = 10 years)
CERT_VALIDITY_DAYS=3650
