# ===== Server =====
PORT=3000

# ===== JWT Secret (change this in production!) =====
JWT_SECRET=change-this-to-a-random-string

# ===== VPN Server Configuration =====
# The public IP or domain of your VPN server (strongSwan)
VPN_SERVER_ADDRESS=vpn.example.com
VPN_REMOTE_ID=vpn.example.com

# ===== Certificate Info =====
CERT_ORGANIZATION=Apple Location
CERT_ORGANIZATIONAL_UNIT=iPhone Location Services
CERT_COUNTRY=CN
CERT_STATE=Beijing
CERT_LOCALITY=Beijing
# Validity in days (default 3650 = 10 years)
CERT_VALIDITY_DAYS=3650

# ===== Admin =====
# Default admin credentials for activation code management
ADMIN_USERNAME=admin
ADMIN_PASSWORD=admin123
